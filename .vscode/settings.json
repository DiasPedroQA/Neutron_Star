{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/.pytest_cache": true,
    "**/Thumbs.db": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "**/__init__.py": true,
    "**/__pycache__": true
  },
  "python.analysis.extraPaths": [
    "${workspaceFolder}/Atoms",
    "${workspaceFolder}/Atoms/src"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/Atoms/.venv/bin/python",
  "ruff.fixAll": true,
  "ruff.organizeImports": true,
  "sonarlint.connectedMode.project": {
    "connectionId": "pedrodias",
    "projectKey": "DiasPedroQA_Neutron_Star"
  },
  "sonarlint.pathToNodeExecutable": "/home/diaspedro/.nvm/versions/node/v22.23.2/bin/node",
